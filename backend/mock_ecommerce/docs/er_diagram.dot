digraph ecommerce {
graph [rankdir=LR, bgcolor="white", pad="0.30", nodesep="0.50", ranksep="0.80", splines=polyline, fontname="DejaVu Sans"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#79899c", penwidth=1.6, fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>CATEGORIES</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>category_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">category_name</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">department</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">is_active</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">BOOLEAN</FONT></TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>CUSTOMERS</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>customer_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">first_name</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">last_name</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">email</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">phone</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">city</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">state</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">postal_code</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">country</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">date_of_birth</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">signup_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">customer_status</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>PRODUCTS</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>product_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>category_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(FK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">sku</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">product_name</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">brand</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">list_price</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">stock_quantity</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">INTEGER</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">launch_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">discontinued_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">is_active</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">BOOLEAN</FONT></TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>ORDERS</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>order_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>customer_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(FK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">order_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">sales_channel</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">order_status</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">items_subtotal</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">shipping_fee</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">order_discount</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">total_amount</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">currency</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">shipping_city</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">shipping_state</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>ORDER_ITEMS</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>order_item_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>order_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(FK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>product_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(FK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">quantity</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">INTEGER</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">unit_price</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">item_discount</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">line_amount</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>PAYMENTS</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>payment_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>order_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(FK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">payment_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">payment_amount</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">payment_method</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">payment_status</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">refund_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR></TABLE>>];
shipments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#bccbd8"><TR><TD BGCOLOR="#183451" COLSPAN="2" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="15"><B>SHIPMENTS</B></FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>shipment_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(PK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#1a4a70" POINT-SIZE="10"><B>order_id</B> <FONT COLOR="#3970a2" POINT-SIZE="9">(FK)</FONT></FONT></TD><TD BGCOLOR="#f2f7fc" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">tracking_number</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">carrier</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">shipped_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">delivered_date</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#263c4c" POINT-SIZE="10">shipment_status</FONT></TD><TD BGCOLOR="#ffffff" ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans" COLOR="#738398" POINT-SIZE="9">STRING</FONT></TD></TR></TABLE>>];
products -> categories [label="category_id", color="#7189a6"];
orders -> customers [label="customer_id", color="#7189a6"];
order_items -> orders [label="order_id", color="#7189a6"];
order_items -> products [label="product_id", color="#7189a6"];
